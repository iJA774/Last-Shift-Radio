  "dialogue_nodes": [
    {
      "id": "dlg_warren_open",
      "event_id": "call_01_warren",
      "speaker": "沃伦",
      "text": "喂，WMLH？是我沃伦。雨一落下来膝盖就像塞了把锉刀。能把《米尔黑文，我的母亲》留到下一段吗？",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_warren_song",
          "text": "我记下了，先找个暖和地方歇着。",
          "next_node_id": "dlg_warren_follow",
          "reveals_statement_ids": []
        },
        {
          "id": "opt_warren_sober",
          "text": "你听起来喝多了，今晚别开车。",
          "next_node_id": "dlg_warren_follow",
          "reveals_statement_ids": []
        }
      ]
    },
    {
      "id": "dlg_warren_follow",
      "event_id": "call_01_warren",
      "speaker": "沃伦",
      "text": "你们夜班总比酒吧里的说法靠谱些。那事要不要提一句？",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_warren_follow_report",
          "text": "北桥那边具体出了什么事？我只会按未核实传闻记录。",
          "next_node_id": "dlg_warren_song_end",
          "reveals_statement_ids": [
            "statement_warren_tanker_fire_claim"
          ]
        },
        {
          "id": "opt_warren_follow_caution",
          "text": "我先等官方消息，你也别往桥边去。",
          "next_node_id": "dlg_warren_sober_end",
          "reveals_statement_ids": []
        }
      ]
    },
    {
      "id": "dlg_warren_song_end",
      "event_id": "call_01_warren",
      "speaker": "沃伦",
      "text": "好，好。对了，威廉酒吧有人说北桥那边一辆油罐车翻了，车头还在冒烟。我没亲眼瞧见，只是觉得你们别等天亮才提。",
      "is_terminal": true,
      "reveals_statement_ids": [],
      "options": []
    },
    {
      "id": "dlg_warren_sober_end",
      "event_id": "call_01_warren",
      "speaker": "沃伦",
      "text": "我没开车，真没。酒吧里有人嚷北桥那边油罐车翻了还冒烟，雨里什么也看不清，别把我的话当新闻。",
      "is_terminal": true,
      "reveals_statement_ids": [],
      "options": []
    },
    {
      "id": "dlg_wrong_number_open",
      "event_id": "call_02_wrong_number",
      "speaker": "夜班烘焙工",
      "text": "你好，是奥尔森仓库吗？我这边三袋高筋粉少了一袋，司机说单子在你们那里。",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_wrong_number_correct",
          "text": "这里是 WMLH 电台，不是仓库。",
          "next_node_id": "dlg_wrong_number_follow",
          "reveals_statement_ids": []
        },
        {
          "id": "opt_wrong_number_kind",
          "text": "你拨错了，不过祝你能找到那袋面粉。",
          "next_node_id": "dlg_wrong_number_follow",
          "reveals_statement_ids": []
        }
      ]
    },
    {
      "id": "dlg_wrong_number_follow",
      "event_id": "call_02_wrong_number",
      "speaker": "夜班烘焙工",
      "text": "我该去问司机，还是先把炉里的面包拉出来？",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_wrong_number_follow_driver",
          "text": "先顾烤炉，再按送货单找司机。",
          "next_node_id": "dlg_wrong_number_correct_end",
          "reveals_statement_ids": []
        },
        {
          "id": "opt_wrong_number_follow_number",
          "text": "找仓库总机，他们能查到收货人。",
          "next_node_id": "dlg_wrong_number_kind_end",
          "reveals_statement_ids": []
        }
      ]
    },
    {
      "id": "dlg_wrong_number_correct_end",
      "event_id": "call_02_wrong_number",
      "speaker": "夜班烘焙工",
      "text": "电台？天啊，难怪没人回我货号。抱歉，夜里烤炉一响人就糊涂了。",
      "is_terminal": true,
      "reveals_statement_ids": [],
      "options": []
    },
    {
      "id": "dlg_wrong_number_kind_end",
      "event_id": "call_02_wrong_number",
      "speaker": "夜班烘焙工",
      "text": "谢谢。要是它在烤炉旁边，我明早大概就能闻出来。抱歉打扰。",
      "is_terminal": true,
      "reveals_statement_ids": [],
      "options": []
    },
    {
      "id": "dlg_martha_open",
      "event_id": "call_03_martha",
      "speaker": "玛莎·克莱恩",
      "text": "请问……你们有没有听见北桥那边的消息？我儿子丹尼本来只说出去给朋友送东西，到现在也没回家。",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_martha_vehicle",
          "text": "请说说他开的车和可能的路线。",
          "next_node_id": "dlg_martha_follow",
          "reveals_statement_ids": ["statement_martha_wagon_route"]
        },
        {
          "id": "opt_martha_calm",
          "text": "我们会留意消息。先告诉我他的名字和回家时间。",
          "next_node_id": "dlg_martha_follow",
          "reveals_statement_ids": []
        }
      ]
    },
    {
      "id": "dlg_martha_follow",
      "event_id": "call_03_martha",
      "speaker": "玛莎·克莱恩",
      "text": "我不想让人冒险去找他，可我什么都做不了。你们能不能替我留意一下？",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_martha_follow_request",
          "text": "我可以征集安全地点的目击信息。",
          "next_node_id": "dlg_martha_vehicle_end",
          "reveals_statement_ids": []
        },
        {
          "id": "opt_martha_follow_official",
          "text": "先联系警方，也请保持电话畅通。",
          "next_node_id": "dlg_martha_calm_end",
          "reveals_statement_ids": []
        }
      ]
    },
    {
      "id": "dlg_martha_vehicle_end",
      "event_id": "call_03_martha",
      "speaker": "玛莎·克莱恩",
      "text": "丹尼·克莱恩，开的我那辆旧旅行车，天太黑看着是很深的颜色。右后灯总是接触不好，颠一下才会亮。他常从北桥回城南。",
      "is_terminal": true,
      "reveals_statement_ids": [],
      "options": []
    },
    {
      "id": "dlg_martha_calm_end",
      "event_id": "call_03_martha",
      "speaker": "玛莎·克莱恩",
      "text": "他叫丹尼，十一点前说半小时就回。车是老旅行车，右后灯总犯毛病。要是有人打来提到它，拜托让他们别挂。",
      "is_terminal": true,
      "reveals_statement_ids": [],
      "options": []
    },
    {
      "id": "dlg_dog_walker_open",
      "event_id": "call_04_dog_walker",
      "speaker": "河边遛狗者",
      "text": "是你们刚才在征集那辆旅行车的消息吗？我在河堤遛狗，桥西头乱成一团时，有辆很旧的车从那边慢慢挪走了。",
      "is_terminal": false,
      "reveals_statement_ids": [],
      "options": [
        {
          "id": "opt_dog_walker_color",
          "text": "你看清车的颜色或车牌了吗？",
