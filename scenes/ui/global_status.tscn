[ext_resource type="Texture2D" path="res://art/ui/low_saturation_v1/icons/runtime/icon_phone_ringing.png" id="2_ringing_icon"]

[node name="GlobalStatus" type="PanelContainer"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 3
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
script = ExtResource("1_script")

[node name="Content" type="HBoxContainer" parent="."]
layout_mode = 2
