  "lore": {
    "premise": "00:00 到 02:00 的 WMLH 夜班中，玩家一边处理普通地方来电，一边逐步发现北桥封闭、失踪司机丹尼的旧旅行车、互相冲突的目击与异常广播之间存在无法轻易解释的矛盾。",
    "themes": [
      "深夜孤独",
      "证词与事实的边界",
      "记忆的不可靠",
      "在信息不足时保持克制"
    ],
    "atmosphere": "持续降雨、河谷低雾和老式电台设备制造出封闭而现实的夜班质感；前半夜尽量让异常仍可被普通事故、误听或记忆偏差解释。",
    "director_notes": [
      "不要过早证明超自然现象。",
      "优先利用已经存在的电话、Statement、Fact 和 Opportunity 推进张力。",
      "普通错号、影院和比分来电应继续承担真实地方电台夜班的节奏对照。",
      "Director-only lore 是导演视角数据，不得作为 Actor 自动获得的知识。"
    ]
  },
  "hidden_truths": [
    {
      "id": "truth_ronnie_memory_break_is_subjective",
      "body": "罗尼第二通电话中的记忆断裂确实是他当下主观体验的一部分，但其原因在本局世界权威中仍未知，不能被 Director 擅自解释成某种已确认超自然机制。"
    },
    {
      "id": "truth_anomaly_cause_remains_unknown",
      "body": "本局没有任何已确认 Fact 解释异常广播、北桥矛盾与旅行车重复目击的最终成因；Director 可以看见冲突全貌，但不能发明缺失的因果真相。"
    }
  ],
